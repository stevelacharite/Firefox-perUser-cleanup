# FIREFOX INSTALLATION CHECK V1.5
# Windows PowerShell 5.1
# Lecture seule - Copier/coller direct

& {

    $ErrorActionPreference = 'Continue'
    $Results = @()

    Write-Host ''
    Write-Host '===== FIREFOX INSTALLATION CHECK V1.5 =====' -ForegroundColor Cyan

    # 1 - PER MACHINE FILES

    Write-Host ''
    Write-Host '[1] PER MACHINE - FILES' -ForegroundColor Yellow

    $MachinePaths = @(
        'C:\Program Files\Mozilla Firefox\firefox.exe'
        'C:\Program Files (x86)\Mozilla Firefox\firefox.exe'
    )

    foreach ($Path in $MachinePaths) {
        if (Test-Path -LiteralPath $Path) {
            $File = Get-Item -LiteralPath $Path
            $Results += [PSCustomObject]@{
                Type = 'MACHINE'
                Source = 'FILE'
                Version = $File.VersionInfo.ProductVersion
                Location = $Path
            }
            Write-Host 'FOUND:' $Path -ForegroundColor Green
        }
    }

    # 2 - PER USER FILES

    Write-Host ''
    Write-Host '[2] PER USER - FILES' -ForegroundColor Yellow

    $ProfileRoot = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'

    $Profiles = @()

    foreach ($Key in (Get-ChildItem -LiteralPath $ProfileRoot -ErrorAction SilentlyContinue)) {
        $Info = Get-ItemProperty -LiteralPath $Key.PSPath -ErrorAction SilentlyContinue

        if ($null -ne $Info) {
            if ($Info.ProfileImagePath) {
                $Profile = [Environment]::ExpandEnvironmentVariables($Info.ProfileImagePath)
                $Profiles += $Profile
            }
        }
    }

    $Profiles = @($Profiles | Sort-Object -Unique)

    foreach ($Profile in $Profiles) {
        $Path = Join-Path $Profile 'AppData\Local\Mozilla Firefox\firefox.exe'

        if (Test-Path -LiteralPath $Path) {
            $File = Get-Item -LiteralPath $Path
            $Results += [PSCustomObject]@{
                Type = 'USER'
                Source = 'FILE'
                Version = $File.VersionInfo.ProductVersion
                Location = $Path
            }
            Write-Host 'FOUND:' $Path -ForegroundColor Red
        }
    }

