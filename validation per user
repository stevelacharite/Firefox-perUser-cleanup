# 1. PER-MACHINE - FICHIERS
# ============================================================

Write-Host ''
Write-Host '[1] Installations PER-MACHINE - Fichiers' `
    -ForegroundColor Yellow

$MachinePaths = @()

if ($env:ProgramFiles) {
    $MachinePaths += Join-Path $env:ProgramFiles `
        'Mozilla Firefox\firefox.exe'
}

$ProgramFilesX86 = [Environment]::GetEnvironmentVariable(
    'ProgramFiles(x86)'
)

if ($ProgramFilesX86) {
    $MachinePaths += Join-Path $ProgramFilesX86 `
        'Mozilla Firefox\firefox.exe'
}

$MachinePaths = @($MachinePaths | Select-Object -Unique)

foreach ($Path in $MachinePaths) {

    if (Test-Path -LiteralPath $Path) {

        $FirefoxVersion = Get-FirefoxVersion -FilePath $Path

        Add-FirefoxResult `
            -Type 'PER-MACHINE' `
            -Source 'Fichier' `
            -Version $FirefoxVersion `
            -Path $Path `
            -Status 'INSTALLE'

        Write-Host "  TROUVE : $Path" -ForegroundColor Green
        Write-Host "  Version : $FirefoxVersion"
    }
}

