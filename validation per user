# 4. INSTALLATIONS PER-USER - REGISTRE

Write-Host "`n[4] Verification du registre PER-USER" -ForegroundColor Yellow

$UserHives = Get-ChildItem 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue |
    Where-Object {
        $_.PSChildName -match '^S-1-5-21-\d+-\d+-\d+-\d+$'
    }

foreach ($Hive in $UserHives) {

    $SID = $Hive.PSChildName

    $RegPath = "Registry::HKEY_USERS\$SID\Software\Microsoft\Windows\CurrentVersion\Uninstall"

    if (-not (Test-Path $RegPath)) {
        continue
    }

    foreach ($Entry in (Get-ChildItem $RegPath -ErrorAction SilentlyContinue)) {

        $App = Get-ItemProperty -LiteralPath $Entry.PSPath -ErrorAction SilentlyContinue

        if ($App.DisplayName -match '^Mozilla Firefox(?:\s|$)') {

            $Results += [PSCustomObject]@{
                Type    = 'PER-USER'
                Source  = 'Registre'
                Version = $App.DisplayVersion
                Path    = $Entry.PSPath
            }

            Write-Host "TROUVE : $($App.DisplayName) [$SID]" -ForegroundColor Red
        }
    }
}
