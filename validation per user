$ErrorActionPreference = 'Continue'

$Version = '1.2'
$Root = 'C:\Install\Firefox'
$Report = Join-Path $Root 'Firefox-Check.txt'

New-Item -Path $Root -ItemType Directory -Force |
    Out-Null

$Results = New-Object System.Collections.ArrayList

function Add-FirefoxResult {

    param(
        [string]$Type,
        [string]$Source,
        [string]$Version,
        [string]$Path,
        [string]$Status
    )

    $Item = [PSCustomObject]@{
        Type    = $Type
        Source  = $Source
        Version = $Version
        Status  = $Status
        Path    = $Path
    }

    [void]$Results.Add($Item)
}

function Get-FirefoxVersion {

    param(
        [string]$FilePath
    )

    try {
        $File = Get-Item -LiteralPath $FilePath `
            -ErrorAction Stop

        return $File.VersionInfo.ProductVersion
    }
    catch {
        return 'Inconnue'
    }
}

function Test-FirefoxRegistry {

    param(
        [string]$RegistryPath,
        [string]$InstallType
    )

    if (-not (Test-Path -LiteralPath $RegistryPath)) {
        return
    }

    $Entries = Get-ChildItem -LiteralPath $RegistryPath `
        -ErrorAction SilentlyContinue

    foreach ($Entry in $Entries) {

        $App = Get-ItemProperty -LiteralPath $Entry.PSPath `
            -ErrorAction SilentlyContinue

        if ($null -eq $App) {
            continue
        }

        if ($App.DisplayName -notmatch '^Mozilla Firefox(?:\s|$)') {
            continue
        }

        $Version = $App.DisplayVersion

        $Status = 'REFERENCE REGISTRE'

        if ($App.InstallLocation) {

            $Executable = Join-Path $App.InstallLocation `
                'firefox.exe'

            if (Test-Path -LiteralPath $Executable) {
                $Status = 'FICHIER PRESENT'
            }
            else {
                $Status = 'EMPLACEMENT ABSENT'
            }
        }

        Add-FirefoxResult `
            -Type $InstallType `
            -Source 'Registre' `
            -Version $Version `
            -Path $Entry.PSPath `
            -Status $Status

        Write-Host "  $($App.DisplayName) - $Version" `
            -ForegroundColor Cyan

        Write-Host "  Etat : $Status"
    }
}

