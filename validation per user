function Add-Result {
    param(
        [string]$Type,
        [string]$Source,
        [string]$Version,
        [string]$Status,
        [string]$Location,
        [string]$Details
    )

    $Item = [PSCustomObject]@{
        Type = $Type
        Source = $Source
        Version = $Version
        Status = $Status
        Location = $Location
        Details = $Details
    }

    [void]$Results.Add($Item)
}

function Get-ExeVersion {
    param([string]$Path)

    try {
        $Item = Get-Item -LiteralPath $Path -ErrorAction Stop
        $Value = $Item.VersionInfo.ProductVersion

        if ([string]::IsNullOrWhiteSpace($Value)) {
            $Value = $Item.VersionInfo.FileVersion
        }

        if ([string]::IsNullOrWhiteSpace($Value)) {
            return 'UNKNOWN'
        }

        return $Value
    }
    catch {
        return 'UNKNOWN'
    }
}

