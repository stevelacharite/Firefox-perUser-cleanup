# FIREFOX INSTALLATION CHECK V1.3
# Compatible PowerShell 5.1
# Lecture seule - Copier/coller direct

$ErrorActionPreference = 'Continue'
$Results = @()

Write-Host ''
Write-Host '===== FIREFOX INSTALLATION CHECK V1.3 =====' -ForegroundColor Cyan

# 1 - FICHIERS PER-MACHINE

Write-Host ''
Write-Host '[1] Fichiers PER-MACHINE' -ForegroundColor Yellow

$MachinePaths = @(
    'C:\Program Files\Mozilla Firefox\firefox.exe'
    'C:\Program Files (x86)\Mozilla Firefox\firefox.exe'
)

foreach ($Path in $MachinePaths) {
    if (Test-Path -LiteralPath $Path) {
        $Version = (Get-Item -LiteralPath $Path).VersionInfo.ProductVersion
        $Results += [PSCustomObject]@{ Type='PER-MACHINE'; Source='Fichier'; Version=$Version; Path=$Path }
        Write-Host "TROUVE : $Path [$Version]" -ForegroundColor Green
    }
}

# 2 - FICHIERS PER-USER

Write-Host ''
Write-Host '[2] Fichiers PER-USER' -ForegroundColor Yellow

$ProfileRoot = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList'

$Profiles = @(Get-ChildItem -Path $ProfileRoot -ErrorAction SilentlyContinue | ForEach-Object {
    $Info = Get-ItemProperty -LiteralPath $_.PSPath -ErrorAction SilentlyContinue
    if ($Info.ProfileImagePath) {
        [Environment]::ExpandEnvironmentVariables($Info.ProfileImagePath)
    }
} | Sort-Object -Unique)

foreach ($Profile in $Profiles) {
    $Path = Join-Path $Profile 'AppData\Local\Mozilla Firefox\firefox.exe'
    if (Test-Path -LiteralPath $Path) {
        $Version = (Get-Item -LiteralPath $Path).VersionInfo.ProductVersion
        $Results += [PSCustomObject]@{ Type='PER-USER'; Source='Fichier'; Version=$Version; Path=$Path }
        Write-Host "TROUVE : $Path [$Version]" -ForegroundColor Red
    }
}

# 3 - REGISTRE PER-MACHINE

Write-Host ''
Write-Host '[3] Registre PER-MACHINE' -ForegroundColor Yellow

$MachineReg = @(
    'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall'
    'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall'
)

foreach ($Root in $MachineReg) {
    foreach ($Key in @(Get-ChildItem -LiteralPath $Root -ErrorAction SilentlyContinue)) {
        $App = Get-ItemProperty -LiteralPath $Key.PSPath -ErrorAction SilentlyContinue
        if ($null -ne $App -and $App.DisplayName -match '^Mozilla Firefox') {
            $Results += [PSCustomObject]@{ Type='PER-MACHINE'; Source='Registre'; Version=$App.DisplayVersion; Path=$Key.Name }
            Write-Host "TROUVE : $($App.DisplayName) [$($App.DisplayVersion)]" -ForegroundColor Green
        }
    }
}

# 4 - REGISTRE PER-USER

Write-Host ''
Write-Host '[4] Registre PER-USER' -ForegroundColor Yellow

$Hives = @(Get-ChildItem -Path 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -match '^S-1-5-21-\d+-\d+-\d+-\d+$' })

foreach ($Hive in $Hives) {
    $SID = $Hive.PSChildName
    $Root = 'Registry::HKEY_USERS\' + $SID + '\Software\Microsoft\Windows\CurrentVersion\Uninstall'

    foreach ($Key in @(Get-ChildItem -LiteralPath $Root -ErrorAction SilentlyContinue)) {
        $App = Get-ItemProperty -LiteralPath $Key.PSPath -ErrorAction SilentlyContinue
        if ($null -ne $App -and $App.DisplayName -match '^Mozilla Firefox') {
            $Results += [PSCustomObject]@{ Type='PER-USER'; Source='Registre'; Version=$App.DisplayVersion; Path=$Key.Name }
            Write-Host "TROUVE : $($App.DisplayName) [$SID]" -ForegroundColor Red
        }
    }
}

# 5 - RESULTATS

Write-Host ''
Write-Host '===== RESULTATS DETAILLES =====' -ForegroundColor Cyan

if ($Results.Count -gt 0) {
    $Results | Format-Table Type,Source,Version,Path -AutoSize -Wrap
} else {
    Write-Host 'Aucune installation Firefox detectee.' -ForegroundColor Yellow
}

# 6 - SOMMAIRE

$MachineFiles = @($Results | Where-Object { $_.Type -eq 'PER-MACHINE' -and $_.Source -eq 'Fichier' }).Count
$MachineRegCount = @($Results | Where-Object { $_.Type -eq 'PER-MACHINE' -and $_.Source -eq 'Registre' }).Count
$UserFiles = @($Results | Where-Object { $_.Type -eq 'PER-USER' -and $_.Source -eq 'Fichier' }).Count
$UserRegCount = @($Results | Where-Object { $_.Type -eq 'PER-USER' -and $_.Source -eq 'Registre' }).Count

Write-Host ''
Write-Host '===== SOMMAIRE =====' -ForegroundColor Cyan
Write-Host "PER-MACHINE - Fichiers : $MachineFiles"
Write-Host "PER-MACHINE - Registre : $MachineRegCount"
Write-Host "PER-USER    - Fichiers : $UserFiles"
